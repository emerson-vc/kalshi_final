# combo-edge configuration. Copy to .env and fill in. .env is gitignored.
# One NAME=value per line. Never paste a key into a line without a NAME=.

# Which Kalshi environment the app, the recorder and the re-quote panel use:
# demo (default), prod, or mock (offline fake exchange for trying the dashboard).
KALSHI_ENV=demo

# Demo and prod keys are separate and NOT interchangeable.
# Create keys at demo.kalshi.co / kalshi.com -> Account -> API keys.
# The key id is the UUID shown when you create the key. Save the private key as a
# file OUTSIDE this repo (for example ~/.kalshi/prod.pem) and run: chmod 600 <file>
# RSA (RSA-PSS) and Ed25519 keys both work.
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=

KALSHI_PROD_API_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=

# Optional alternative to the *_PATH variables: the PEM itself, with literal \n
# between lines, e.g. "-----BEGIN PRIVATE KEY-----\nMC4C...\n-----END PRIVATE KEY-----"
# KALSHI_PROD_PRIVATE_KEY_PEM=
# KALSHI_DEMO_PRIVATE_KEY_PEM=

# ---- Optional (defaults shown) ----
# Where SQLite, logs, nflverse cache and reports live.
# COMBO_EDGE_DATA_DIR=data
# Dashboard bind address. Keep it on localhost.
# COMBO_EDGE_HOST=127.0.0.1
# COMBO_EDGE_PORT=8000
# Set to 1 to make live execution impossible to enable (paper/off only).
# COMBO_EDGE_FORBID_LIVE=0
